#!/usr/bin/env node
// agentbar — cross-platform CLI over the AgentBar file protocol (~/.agentbar).
// The folder is the protocol, so this CLI is a full peer of the macOS app: on Linux
// it IS AgentBar. Contract: docs/protocol.md. No dependencies, Node >= 16.
//
//   agentbar status [--json]        live sessions
//   agentbar requests [--json]      pending approvals with inline detail
//   agentbar approve [n] [--always] answer the newest (or n-th) pending request
//   agentbar deny [n]
//   agentbar watch [-i SEC]         live view; keys: a allow · A always · d deny ·
//                                   f defer (terminal prompt) · 1-9 answer a
//                                   question · q quit. Holds the watcher heartbeat,
//                                   so hooks offer remote approval while it runs.
//   agentbar waybar                 one-line JSON for waybar/polybar custom modules
//                                   (each call refreshes the heartbeat; poll <= 30s)
//   agentbar history [--days N]     what finished today — state.d forgets, this
//                                   doesn't
//   agentbar doctor [--json]        diagnose a silent integration: hooks wired?
//                                   node path still there? dirs writable? when did
//                                   each agent last report?
//   agentbar install-hooks          wire agent hooks (Claude/Codex/Cursor/Antigravity/
//                                   Gemini/Qwen/Copilot/OpenCode) —
//                                   the Linux equivalent of the macOS app's installer

"use strict";
const fs = require("fs"), os = require("os"), path = require("path");

const base = path.join(os.homedir(), ".agentbar");
const stateDir = path.join(base, "state.d");
const reqDir = path.join(base, "requests.d");
const ansDir = path.join(base, "answers.d");
const watcherFile = path.join(base, "watcher.json");
const historyFile = path.join(base, "history.jsonl");
const seenFile = path.join(base, "history-seen.json");
const PRESENCE_TTL = 60; // seconds a heartbeat stays valid (hooks use the same value)
const HISTORY_MAX_AGE = 30 * 86400; // long enough for a sprint, short enough to stay a file
const HISTORY_MAX = 5000;

const now = () => Math.floor(Date.now() / 1000);
const readJSON = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; } };
const writeAtomic = (f, obj) => {
  const t = f + "." + process.pid + ".tmp";
  fs.writeFileSync(t, JSON.stringify(obj));
  fs.renameSync(t, f);
};
const alive = (pid) => {
  if (!pid || pid <= 0) return false;
  try { process.kill(pid, 0); return true; } catch (e) { return e.code === "EPERM"; }
};

const tty = process.stdout.isTTY;
const c = (code, s) => (tty ? `\x1b[${code}m${s}\x1b[0m` : s);
const dim = (s) => c("2", s), bold = (s) => c("1", s);
const yellow = (s) => c("33", s), blue = (s) => c("34", s), green = (s) => c("32", s), red = (s) => c("31", s);

// MARK: - Stores (liveness rules mirror the app; docs/protocol.md is normative)

function sessions() {
  let files = []; try { files = fs.readdirSync(stateDir); } catch { return []; }
  const out = [];
  for (const f of files) {
    if (!f.endsWith(".json")) continue;
    const p = path.join(stateDir, f);
    const s = readJSON(p);
    if (!s) continue;
    const dead = s.pid > 0 && !alive(s.pid);
    const stale = s.ts > 0 && now() - s.ts > 86400;
    if (dead || stale) { try { fs.rmSync(p, { force: true }); } catch {} continue; }
    if (!s.started) continue;
    s.id = f.slice(0, -".json".length);
    out.push(s);
  }
  out.sort((a, b) => ((PRIORITY[b.state] || 0) - (PRIORITY[a.state] || 0)) || ((b.ts || 0) - (a.ts || 0)));
  return out;
}

// MARK: - History (mirrors Sources/AgentBar/HistoryStore.swift)

// state.d is a *live* set: a row is deleted when its process dies or its ts passes
// 24h, so an agent that ran yesterday and exited cleanly leaves nothing at all.
// Without a record, nothing can answer "when did this agent last report anything",
// which is how `doctor` tells a broken integration apart from an idle one.
//
// Append-only, one line per ended session; a session may be written twice (turn
// end, then disappearance) and the reader keeps the last line for an id. The
// sidecar holds the previous tick so one-shot commands can diff too.
const FINISHED = { done: 1, error: 1 };   // deliberately not "idle" — see HistoryStore.swift

function recordHistory(ss) {
  try {
    const live = {};
    for (const s of ss) if (s.started !== false) live[s.id] = s;
    const prev = readJSON(seenFile);
    fs.mkdirSync(base, { recursive: true });
    const t = seenFile + "." + process.pid + ".tmp";
    fs.writeFileSync(t, JSON.stringify(live));
    fs.renameSync(t, seenFile);
    if (!prev) return; // first run is a baseline, not a hundred endings at once

    const rec = (s, id) => ({
      v: 1, agent: s.agent || "", sessionId: id, project: s.project || "",
      cwd: s.cwd || "", label: s.label || "", prompt: s.prompt || "",
      model: s.model || "", startedAt: Math.floor(s.started_at || 0),
      endedAt: Math.floor(s.ts || now()), state: s.state || "", decayed: false,
    });
    const out = [];
    for (const s of ss) {
      if (!FINISHED[s.state]) continue;
      if (prev[s.id] && FINISHED[prev[s.id].state]) continue; // edge only
      out.push(rec(s, s.id));
    }
    for (const id of Object.keys(prev)) if (!live[id]) out.push(rec(prev[id], id));
    if (!out.length) return;
    out.sort((a, b) => a.endedAt - b.endedAt || (a.sessionId < b.sessionId ? -1 : 1));
    fs.appendFileSync(historyFile, out.map((r) => JSON.stringify(r)).join("\n") + "\n");
    pruneHistory();
  } catch {}
}

// Reads every line that still parses, last-line-per-id wins. A line torn by a
// crash mid-append costs that line and nothing else.
function readHistory() {
  let text = ""; try { text = fs.readFileSync(historyFile, "utf8"); } catch { return []; }
  const byID = new Map();
  for (const line of text.split("\n")) {
    if (!line.trim()) continue;
    let r; try { r = JSON.parse(line); } catch { continue; }
    if (!r || !r.sessionId) continue;
    byID.delete(r.sessionId);   // re-insert so the newest keeps its arrival order
    byID.set(r.sessionId, r);
  }
  return [...byID.values()];
}

// A LENGTH of time, not an age — `elapsed()` above takes a timestamp and subtracts
// it from now, which is a different thing and silently renders 56 years when handed
// a duration. Same vocabulary as HistoryDigest.duration on the app side, so the two
// frontends do not describe time two different ways.
function durationText(seconds) {
  const d = Math.max(0, Math.floor(seconds));
  if (d < 60) return "<1m";
  if (d < 3600) return `${Math.floor(d / 60)}m`;
  const h = Math.floor(d / 3600), m = Math.floor((d % 3600) / 60);
  return m === 0 ? `${h}h` : `${h}h ${m}m`;
}

// What finished, read back out of history.jsonl. `status` answers "what is
// happening"; this is the only thing that answers "what happened", because state.d
// deletes a session the moment its process dies.
function printHistory(argv, json) {
  const d = argv.indexOf("--days");
  const days = Math.max(1, parseInt(d >= 0 ? argv[d + 1] : "1", 10) || 1);
  // Local midnight, not "the last N*24 hours": a day that starts whenever you
  // happen to look at it is not a day.
  const midnight = new Date(); midnight.setHours(0, 0, 0, 0);
  const since = Math.floor(midnight.getTime() / 1000) - (days - 1) * 86400;

  const rows = readHistory()
    .filter((r) => (r.endedAt || 0) >= since)
    .sort((a, b) => (b.endedAt || 0) - (a.endedAt || 0));
  if (json) return console.log(JSON.stringify(rows, null, 2));
  if (!rows.length) return console.log(dim(days === 1 ? "Nothing finished yet today" : `Nothing in the last ${days} days`));

  let measured = 0, seconds = 0;
  for (const r of rows) {
    if (r.startedAt > 0 && r.endedAt >= r.startedAt) { seconds += r.endedAt - r.startedAt; measured++; }
  }
  const failed = rows.filter((r) => r.state === "error").length;
  for (const r of rows) {
    const when = new Date((r.endedAt || 0) * 1000)
      .toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    const dur = r.startedAt > 0 && r.endedAt >= r.startedAt ? durationText(r.endedAt - r.startedAt) : "";
    const name = r.project || r.agent || "session";
    const mark = r.state === "error" ? red("✗") : green("✓");
    console.log(`${mark} ${dim(when)}  ${bold(name.padEnd(22))} ${dim((dur || "").padStart(6))}  ${dim(r.agent)}`);
  }
  // A partial total presented as the day's work is a number someone would quote.
  const total = measured === rows.length
    ? durationText(seconds)
    : measured ? `${durationText(seconds)} across ${measured}` : "";
  const parts = [`${rows.length} session${rows.length === 1 ? "" : "s"}`];
  if (total) parts.push(total);
  if (failed) parts.push(`${failed} failed`);
  console.log("\n" + parts.join(" · "));
}

function pruneHistory() {
  try {
    const all = readHistory();
    let kept = all.filter((r) => now() - (r.endedAt || 0) <= HISTORY_MAX_AGE);
    if (kept.length > HISTORY_MAX) kept = kept.slice(-HISTORY_MAX);
    if (kept.length === all.length) return;
    const t = historyFile + "." + process.pid + ".tmp";
    fs.writeFileSync(t, kept.length ? kept.map((r) => JSON.stringify(r)).join("\n") + "\n" : "");
    fs.renameSync(t, historyFile);
  } catch {}
}

function requests() {
  let files = []; try { files = fs.readdirSync(reqDir); } catch { return []; }
  const out = [];
  for (const f of files) {
    if (!f.endsWith(".json")) continue;
    const p = path.join(reqDir, f);
    const r = readJSON(p);
    if (!r) continue;
    const watched = r.hookPid > 0 ? r.hookPid : r.pid;
    const dead = watched > 0 && !alive(watched);
    const expired = r.ts > 0 && now() - r.ts > 660;
    if (dead || expired) { try { fs.rmSync(p, { force: true }); } catch {} continue; }
    r.fileName = f;
    out.push(r);
  }
  out.sort((a, b) => (b.ts || 0) - (a.ts || 0));
  return out;
}

function answer(r, behavior) {
  fs.mkdirSync(ansDir, { recursive: true });
  const obj = { behavior };
  // "always" only sticks when the hook can match it to a rule Claude itself
  // suggested; without a suggestion it degrades to a plain one-shot allow there.
  if (behavior === "always" && r.ruleSuggestion) obj.rule = r.ruleSuggestion;
  // Name the hook this answer is meant for: request names repeat across the
  // tools of one turn, and the hook discards answers aimed at a predecessor.
  if (r.hookPid > 0) obj.hookPid = r.hookPid;
  writeAtomic(path.join(ansDir, r.fileName), obj);
}

// Chosen option labels for a question request, one array per question. The hook
// only accepts labels the request itself offered.
function answerQuestion(r, labels) {
  fs.mkdirSync(ansDir, { recursive: true });
  const obj = { behavior: "answer", answers: labels };
  if (r.hookPid > 0) obj.hookPid = r.hookPid;
  writeAtomic(path.join(ansDir, r.fileName), obj);
}

// Same .git/HEAD trick as the app: no git invocation, handles worktrees.
function gitBranch(cwd) {
  if (!cwd) return null;
  try {
    let g = path.join(cwd, ".git");
    const st = fs.statSync(g);
    if (!st.isDirectory()) {
      const m = fs.readFileSync(g, "utf8").match(/^gitdir:\s*(.+)$/m);
      if (!m) return null;
      g = m[1].trim();
    }
    const head = fs.readFileSync(path.join(g, "HEAD"), "utf8").trim();
    return head.startsWith("ref: refs/heads/") ? head.slice("ref: refs/heads/".length) : head.slice(0, 7);
  } catch { return null; }
}

// MARK: - Rendering

const DOTS = { permission: yellow("●"), question: blue("●"), thinking: green("●"), tool: green("●"), error: red("●"), idle: dim("●"), done: dim("●") };
// What to surface first — same weights the app sorts by. A failure ranks above
// the clean finishes so it can't be buried, but below live work.
const PRIORITY = { permission: 4, question: 3, thinking: 2, tool: 2, error: 1, idle: 0, done: 0 };

// Optional per docs/protocol.md: absent started_at simply renders nothing.
function elapsed(startedAt) {
  if (!startedAt || startedAt <= 0) return null;
  const d = now() - startedAt;
  if (d < 0) return null;
  if (d < 60) return `${d}s`;
  if (d < 3600) return `${Math.floor(d / 60)}m`;
  return `${Math.floor(d / 3600)}h${String(Math.floor((d % 3600) / 60)).padStart(2, "0")}`;
}

function sessionLine(s) {
  const name = s.project || "session";
  const branch = gitBranch(s.cwd);
  const age = elapsed(s.started_at);
  const label = s.state === "permission" ? yellow("needs approval")
    : s.state === "question" ? blue(s.label || "waiting for your answer")
    : s.state === "error" ? red("failed") + (s.label ? dim(" — " + s.label) : "")
    : (s.label ? dim(s.label) : dim(s.state));
  return `${DOTS[s.state] || dim("●")} ${bold(name)}${branch ? dim(" · " + branch) : ""}  ${label}${age ? dim("  " + age) : ""}  ${dim((s.agent || "?").toUpperCase())}`;
}

function printStatus(json) {
  const ss = sessions();
  recordHistory(ss);
  if (json) return console.log(JSON.stringify(ss, null, 2));
  if (!ss.length) return console.log(dim("No active sessions"));
  for (const s of ss) console.log(sessionLine(s));
}

function printRequests(json) {
  const rs = requests();
  if (json) return console.log(JSON.stringify(rs, null, 2));
  if (!rs.length) return console.log(dim("No pending requests"));
  rs.forEach((r, i) => {
    console.log(`${bold(String(i + 1) + ".")} ${yellow(r.display || r.toolName || "request")}  ${dim(r.agent || "")}`);
    const ctx = r.context || {};
    const lines = (s, mark) => String(s || "").split("\n").slice(0, 6).forEach((l) => console.log(`   ${mark}${l}`));
    if (ctx.kind === "bash") lines(ctx.command, dim("$ "));
    if (ctx.kind === "diff") { lines(ctx.old, red("− ")); lines(ctx.new, green("+ ")); if (ctx.more) console.log(dim(`   +${ctx.more} more edit(s)`)); }
    if (ctx.kind === "write") lines(ctx.preview, dim("  "));
    // The plan is the thing being approved — show more of it than a preview.
    if (ctx.kind === "plan") {
      const all = String(ctx.plan || "").split("\n");
      all.slice(0, 20).forEach((l) => console.log(`   ${dim("│ ")}${l}`));
      if (all.length > 20) console.log(dim(`   … +${all.length - 20} more lines (--json for all)`));
      console.log(dim("   deny = keep planning · approve happens in the session's own dialog"));
    }
    if (ctx.kind === "question") {
      for (const q of ctx.questions || []) {
        if ((ctx.questions || []).length > 1) console.log(`   ${bold(q.header || q.question)}`);
        (q.options || []).forEach((o, k) =>
          console.log(`   ${bold(String(k + 1) + ")")} ${o.label}${o.description ? dim("  " + o.description) : ""}`));
        if (q.multiSelect) console.log(dim("   (pick several — answer from the app or the wizard)"));
      }
    }
    if (r.ruleSuggestion) console.log(dim("   --always available"));
  });
}

function decide(behavior, argv) {
  const explicit = argv.find((a) => /^\d+$/.test(a));
  const n = parseInt(explicit || "1", 10);
  const always = argv.includes("--always");
  const rs = requests();
  if (!rs.length) { console.error("No pending requests."); process.exit(1); }
  // Bare approve/deny means the newest PERMISSION — a question sorting to the
  // head of the queue must not shadow it. An explicit index is taken literally.
  const r = explicit ? rs[n - 1]
                     : rs.find((x) => (x.context || {}).kind !== "question") || rs[0];
  if (!r) { console.error(`No request #${n} (have ${rs.length}).`); process.exit(1); }
  if ((r.context || {}).kind === "question" && behavior !== "defer") {
    console.error("That's a question, not a permission — pick an option in `agentbar watch` (keys 1-9) or answer in the terminal wizard.");
    process.exit(1);
  }
  if ((r.context || {}).kind === "plan" && behavior === "allow") {
    // The hook cannot approve a plan (the approval also picks the next
    // permission mode); pretending otherwise would print a lie.
    console.error("Plans are approved in the session's own dialog — the hook can't carry the mode choice. Use `agentbar deny` to keep planning, or answer in the terminal.");
    process.exit(1);
  }
  answer(r, behavior === "allow" && always ? "always" : behavior);
  const verb = behavior === "deny"
    ? ((r.context || {}).kind === "plan" ? yellow("✎ keep planning") : red("✕ denied"))
    : green("✓ " + (always ? "always allowed" : "allowed"));
  console.log(`${verb}  ${r.display || r.toolName}`);
}

// A single single-select question's options, when request r is one — the shape
// the digit keys in `watch` can answer.
function simpleQuestion(r) {
  const ctx = r.context || {};
  if (ctx.kind !== "question") return null;
  const qs = ctx.questions || [];
  if (qs.length !== 1 || qs[0].multiSelect) return null;
  return (qs[0].options || []).map((o) => o.label);
}

// `agentbar answer [n] <label...>` — answer a pending question by option label
// (or 1-based option number). Multi-question calls need per-question toggles a
// one-liner can't express; those answer in the app or the wizard.
function answerCmd(argv) {
  const rs = requests();
  const explicit = /^\d+$/.test(argv[0] || "") && argv.length > 1 ? argv.shift() : null;
  const r = explicit ? rs[parseInt(explicit, 10) - 1]
                     : rs.find((x) => (x.context || {}).kind === "question");
  if (!r) { console.error(explicit ? `No request #${explicit}.` : "No pending question."); process.exit(1); }
  const ctx = r.context || {};
  if (ctx.kind !== "question") { console.error(`Request #${explicit || 1} is a permission — use approve/deny.`); process.exit(1); }
  const qs = ctx.questions || [];
  if (qs.length !== 1) { console.error("Multi-question call — answer it in the AgentBar app or the terminal wizard."); process.exit(1); }
  const q = qs[0];
  const labels = (q.options || []).map((o) => o.label);
  const picked = argv.map((a) =>
    /^\d+$/.test(a) ? labels[parseInt(a, 10) - 1] : labels.find((l) => l.toLowerCase() === a.toLowerCase()));
  if (!argv.length || picked.some((l) => !l)) {
    console.error("Pick from: " + labels.map((l, i) => `${i + 1}) ${l}`).join("  "));
    process.exit(1);
  }
  const unique = [...new Set(picked)];
  if (!q.multiSelect && unique.length !== 1) { console.error("Single-select question — pick exactly one option."); process.exit(1); }
  answerQuestion(r, [unique]);
  console.log(`${green("✓ answered")}  ${unique.join(", ")}  ${dim("— " + (q.question || ""))}`);
}

// MARK: - Presence (what makes hooks block for remote approval on Linux)

function heartbeat() {
  fs.mkdirSync(base, { recursive: true });
  writeAtomic(watcherFile, { pid: process.pid, ts: now() });
}
function clearHeartbeat() {
  const w = readJSON(watcherFile);
  if (w && w.pid === process.pid) { try { fs.rmSync(watcherFile, { force: true }); } catch {} }
}

function waybar() {
  heartbeat(); // each poll refreshes presence; keep the module interval <= 30s
  const ss = sessions(), rs = requests();
  recordHistory(ss);
  const pending = ss.filter((s) => s.state === "permission").length;
  // A session blocked on an AskUserQuestion is waiting on the human exactly like
  // a permission is — it must not hide inside "idle".
  const asking = ss.filter((s) => s.state === "question").length;
  const working = ss.filter((s) => s.state === "thinking" || s.state === "tool").length;
  const cls = pending ? "permission" : asking ? "question" : working ? "working" : ss.length ? "idle" : "empty";
  const text = pending ? `✋ ${pending}` : asking ? `❓ ${asking}` : working ? `● ${working}` : ss.length ? `${ss.length}` : "";
  const tooltip = ss.map((s) => `${s.project || "session"} — ${s.state}${s.label ? " · " + s.label : ""} (${s.agent})`)
    .concat(rs.map((r) => `pending: ${r.display}`)).join("\n") || "no sessions";
  console.log(JSON.stringify({ text, alt: cls, class: cls, tooltip }));
}

function watch(argv) {
  const i = argv.indexOf("-i");
  const interval = Math.max(1, parseInt(i >= 0 ? argv[i + 1] : "2", 10) || 2);
  const render = () => {
    heartbeat();
    let out = "\x1b[2J\x1b[H" + bold("AgentBar") + dim(`  ·  a allow · A always · d deny · f defer · 1-9 answer · q quit\n\n`);
    const ss = sessions();
    recordHistory(ss);
    out += ss.length ? ss.map(sessionLine).join("\n") + "\n" : dim("No active sessions\n");
    const rs = requests();
    if (rs.length) {
      out += "\n" + bold("Pending") + "\n";
      const firstQuestion = rs.find((r) => (r.context || {}).kind === "question");
      rs.forEach((r, k) => {
        out += `${k + 1}. ${yellow(r.display || r.toolName)}\n`;
        // The newest question's single-select options answer on a digit key.
        const opts = r === firstQuestion ? simpleQuestion(r) : null;
        if (opts) opts.forEach((label, j) => { out += `   ${bold(String(j + 1) + ")")} ${label}\n`; });
      });
    }
    process.stdout.write(out);
  };
  const timer = setInterval(render, interval * 1000);
  const quit = () => { clearInterval(timer); clearHeartbeat(); process.stdout.write("\n"); process.exit(0); };
  process.on("SIGINT", quit);
  process.on("SIGTERM", quit);
  process.on("SIGHUP", quit); // PTY closed under us — the heartbeat must not outlive the terminal
  if (process.stdin.isTTY) {
    process.stdin.setRawMode(true);
    process.stdin.resume();
    // Keys can arrive several to a chunk (fast typing, pastes, test PTYs) —
    // handle each, not the chunk as one "key".
    process.stdin.on("data", (b) => { for (const k of b.toString()) handleKey(k); });
    const handleKey = (k) => {
      if (k === "q" || k === "\x03") return quit();
      const rs = requests();
      if (!rs.length) return;
      // Letters answer the newest PERMISSION even when a question sorts ahead
      // of it; digits answer the newest question's options. Neither queue can
      // shadow the other.
      const perm = rs.find((r) => (r.context || {}).kind !== "question");
      const quest = rs.find((r) => (r.context || {}).kind === "question");
      if (k === "a" && perm) { answer(perm, "allow"); render(); }
      if (k === "A" && perm) { answer(perm, "always"); render(); }   // allow + the rule Claude suggested
      if (k === "d" && perm) { answer(perm, "deny"); render(); }
      if (k === "f") { answer(rs[0], "defer"); render(); }    // hand the newest back to its own prompt
      if (/^[1-9]$/.test(k) && quest) {
        const opts = simpleQuestion(quest);
        const label = opts && opts[parseInt(k, 10) - 1];
        if (label) { answerQuestion(quest, [[label]]); render(); }
      }
    };
  }
  render();
}

// MARK: - install-hooks (Linux counterpart of the macOS app's HookInstaller;
// same safety rules: never touch an unparseable config, write only on change)

// MARK: - doctor (check ids mirror Sources/AgentBar/Diagnostics.swift; docs/diagnostics.md)

// Every integration here fails the same way: silently. A hook that is not wired is
// an absence, not an error; a hook wired to an interpreter that has moved never
// runs, so it never complains. This re-derives the installation from disk and says
// what is wrong in the words of the fix. Reads only, apart from one write probe.
const INTEGRATIONS = [
  { id: "claude", name: "Claude Code", presence: [".claude"],
    configs: [".claude/settings.json"], marker: "/.agentbar/hooks/claude/" },
  { id: "codex", name: "Codex CLI", presence: [".codex"],
    configs: [".codex/config.toml"], marker: "/.agentbar/hooks/codex/" },
  { id: "copilot", name: "Copilot CLI", presence: [".copilot"],
    configs: [".copilot/hooks/agentbar.json"], marker: "/.agentbar/hooks/claude/" },
  { id: "cursor", name: "Cursor CLI", presence: [".cursor"],
    configs: [".cursor/hooks.json"], marker: "/.agentbar/hooks/cursor/" },
  { id: "gemini", name: "Gemini CLI", presence: [".gemini"],
    configs: [".gemini/settings.json"], marker: "/.agentbar/hooks/gemini/" },
  { id: "qwen", name: "Qwen Code", presence: [".qwen"],
    configs: [".qwen/settings.json"], marker: "/.agentbar/hooks/claude/" },
  { id: "antigravity", name: "Antigravity", presence: [".gemini/antigravity", ".gemini/antigravity-cli"],
    configs: [".gemini/antigravity/hooks.json", ".gemini/antigravity-cli/hooks.json"], marker: "agentbar" },
  { id: "opencode", name: "OpenCode", presence: [".config/opencode"],
    configs: [".config/opencode/plugins/agentbar.js"], marker: "agentbar" },
];
const HOOK_DIRS = ["claude", "codex", "cursor", "gemini", "antigravity", "opencode"];
// Two weeks, not a few days: people go on holiday, and an agent you simply did not
// use must not be reported as broken.
const QUIET_DAYS = 14;
// Keyed by the agent that runs them: install-hooks only pins a script when it
// wires that agent, so checking the others would flag a healthy machine.
const SHEBANG_SCRIPTS = { cursor: "cursor/cursor.js", antigravity: "antigravity/antigravity.js" };

function doctor(json) {
  const H = os.homedir(), out = [];
  const add = (id, title, status, detail, fix) => out.push({ id, title, status, detail, fix });
  const there = (p) => { try { fs.accessSync(p); return true; } catch { return false; } };
  const runnable = (p) => { try { fs.accessSync(p, fs.constants.X_OK); return true; } catch { return false; } };
  const real = (p) => { try { return fs.realpathSync(p); } catch { return null; } };
  const read = (p) => { try { return fs.readFileSync(p, "utf8"); } catch { return null; } };

  const self = real(process.execPath);
  const alias = ["/usr/bin/node", "/usr/local/bin/node", "/opt/homebrew/bin/node",
                 path.join(H, ".local/bin/node")].find((c) => real(c) === self);
  add("node.found", "A node interpreter", "ok", alias || process.execPath);
  add("node.stable", "...at a path that survives an upgrade", alias ? "ok" : "warn",
      alias ? null : `${process.execPath} looks version-pinned, and it is what gets written into every hook config.`,
      alias ? null : "Link a stable alias into /usr/local/bin, then re-run `agentbar install-hooks` — otherwise re-run it after every major node change.");

  for (const [name, dir] of [["state.d", stateDir], ["requests.d", reqDir], ["answers.d", ansDir]]) {
    if (!there(dir)) {
      add(`dirs.${name}`, `~/.agentbar/${name}`, "fail", "Missing.",
          "Run `agentbar install-hooks`, or start any agent session — the hooks create these.");
      continue;
    }
    // Actually write: a directory can exist and still be unusable, and this is the
    // failure hooks hit most often — they have nowhere to report it to.
    const probe = path.join(dir, ".doctor." + process.pid);
    let wrote = false;
    try { fs.writeFileSync(probe, ""); fs.rmSync(probe, { force: true }); wrote = true; } catch {}
    add(`dirs.${name}`, `~/.agentbar/${name}`, wrote ? "ok" : "fail",
        wrote ? null : "Exists but is not writable — hooks cannot report anything.",
        wrote ? null : `chmod u+w ${dir}`);
  }

  const hooks = path.join(base, "hooks");
  const missing = HOOK_DIRS.filter((d) => !there(path.join(hooks, d)));
  add("hooks.copied", "Hook scripts installed", missing.length ? "fail" : "ok",
      missing.length ? `Missing: ${missing.join(", ")}.` : null,
      missing.length ? "Run `agentbar install-hooks` from a repo checkout." : null);
  const relevant = Object.entries(SHEBANG_SCRIPTS).filter(([agent]) =>
    (INTEGRATIONS.find((i) => i.id === agent) || { presence: [] }).presence
      .some((d) => there(path.join(H, d)))).map(([, rel]) => rel);
  if (!relevant.length) {
    add("hooks.shebang", "Scripts that run themselves name a real node", "skipped",
        "Neither Cursor nor Antigravity is installed here.");
  } else {
    const unpinned = relevant.filter((rel) => (read(path.join(hooks, rel)) || "").startsWith("#!/usr/bin/env")).sort();
    add("hooks.shebang", "Scripts that run themselves name a real node", unpinned.length ? "warn" : "ok",
        unpinned.length ? `Still on \`#!/usr/bin/env node\`: ${unpinned.join(", ")}.` : null,
        unpinned.length ? "Run `agentbar install-hooks`. A GUI-launched host inherits a PATH that usually has no node on it, so `env node` silently never fires." : null);
  }

  const hist = readHistory();
  for (const i of INTEGRATIONS) {
    if (!i.presence.some((d) => there(path.join(H, d)))) {
      add(`agent.${i.id}`, i.name, "skipped", "Not installed here.");
      continue;
    }
    let wired = false, absent = null;
    for (const rel of i.configs) {
      const text = read(path.join(H, rel));
      if (text === null) { if (i.configs.length === 1) absent = rel; continue; }
      if (rel.endsWith(".json")) {
        try { JSON.parse(text); } catch {
          add(`agent.${i.id}.parseable`, `${i.name} config parses`, "fail",
              `~/${rel} is not valid JSON, so install-hooks refuses to touch it — deliberately, it is your file.`,
              "Fix the JSON (a `//` comment or a trailing comma is the usual cause), then re-run `agentbar install-hooks`.");
          continue;
        }
      }
      // JSONSerialization escapes forward slashes, so a config the macOS app wrote
      // says "\\/.agentbar\\/hooks\\/claude\\/" on disk. The installers never notice —
      // they match against the parsed value — but raw-text search does, and would
      // report every macOS-written config as unwired.
      const flat = text.replace(/\\\//g, "/");
      if (flat.includes(i.marker)) wired = true;
      const dead = (flat.match(/"(\/[^"]*\/node)"/g) || [])
        .map((m) => m.slice(1, -1)).filter((n) => !runnable(n));
      if (dead.length) {
        add(`agent.${i.id}.interpreter`, `${i.name}'s node still exists`, "fail",
            `~/${rel} points at ${dead[0]}, which is gone. The hooks never run, so they never complain.`,
            "Re-run `agentbar install-hooks` — it repairs the path now.");
      }
    }
    add(`agent.${i.id}.wired`, `${i.name} hooks`, wired ? "ok" : "fail",
        wired ? null : (absent ? `~/${absent} does not exist.` : "Installed, but AgentBar is not wired into it."),
        wired ? null : "Run `agentbar install-hooks`.");
    if (!wired) continue;

    const last = hist.filter((r) => r.agent === i.id).map((r) => r.endedAt || 0).sort((a, b) => b - a)[0];
    // No record is not a problem: history only starts when a frontend starts keeping
    // it, so every agent is blank on a freshly updated machine.
    if (!last) {
      add(`agent.${i.id}.lastSeen`, `${i.name} has reported`, "ok", "No session on record yet.");
    } else {
      const days = Math.floor((now() - last) / 86400);
      if (days >= QUIET_DAYS) {
        add(`agent.${i.id}.lastSeen`, `${i.name} has reported`, "warn", `Wired, but nothing for ${days} days.`,
            `If you have used ${i.name} since then, its hooks are not firing — start a NEW session (hook config is read at session start) and check back.`);
      } else {
        add(`agent.${i.id}.lastSeen`, `${i.name} has reported`, "ok",
            days < 1 ? "Last session today." : `Last session ${days} day${days === 1 ? "" : "s"} ago.`);
      }
    }
    if (i.id === "copilot") {
      const shelled = (read(path.join(H, ".copilot/hooks/agentbar.json")) || "").includes('"bash":');
      add("copilot.exec", "Copilot runs node directly", shelled ? "fail" : "ok",
          shelled ? "The hook is wrapped in a shell, so the hook's parent is a shell that exits at once — and that pid is what prunes dead rows. Every Copilot row would disappear on the next refresh." : null,
          shelled ? "Delete ~/.copilot/hooks/agentbar.json and re-run `agentbar install-hooks`." : null);
    }
  }

  const stale = [];
  for (const [name, dir, maxAge] of [["state.d", stateDir, 86400], ["requests.d", reqDir, 660], ["answers.d", ansDir, 60]]) {
    let files = []; try { files = fs.readdirSync(dir); } catch {}
    const old = files.filter((f) => {
      try { return now() - Math.floor(fs.statSync(path.join(dir, f)).mtimeMs / 1000) > maxAge; } catch { return false; }
    });
    if (old.length) stale.push(`${old.length} in ${name}`);
  }
  add("orphans", "No leftovers in ~/.agentbar", stale.length ? "warn" : "ok",
      stale.length ? `Past their pruning window: ${stale.join(", ")}.` : null,
      stale.length ? "Harmless — frontends skip them. They clear on the next pass." : null);

  // Same precedence the hooks themselves use (see permission.js): on macOS the app
  // is the frontend and pgrep is the answer; everywhere else it is the heartbeat.
  let appHere = false;
  if (process.platform === "darwin") {
    try { require("child_process").execSync("pgrep -x AgentBar", { stdio: "ignore" }); appHere = true; } catch {}
  }
  const w = readJSON(watcherFile);
  const fresh = appHere || !!(w && w.ts && now() - w.ts < PRESENCE_TTL && (!w.pid || alive(w.pid)));
  add("frontend.present", "A frontend that hooks can block for", fresh ? "ok" : "warn",
      fresh ? (appHere ? "The AgentBar app is running." : "watcher.json heartbeat is fresh.") : "Nothing is listening, so hooks fall straight through to the terminal prompt — remote Allow/Deny is off.",
      fresh ? null : (process.platform === "darwin"
        ? "Launch AgentBar, or keep `agentbar watch` running."
        : "Keep `agentbar watch` running (or poll `agentbar waybar` at <= 30s) to answer approvals from here."));

  if (json) return console.log(JSON.stringify(out, null, 2));
  const paint = { ok: green, warn: yellow, fail: red, skipped: dim };
  for (const c of out) {
    console.log(`${paint[c.status](c.status.padEnd(7))} ${bold(c.id.padEnd(28))} ${c.title}`);
    if (c.detail) console.log(`        ${dim(c.detail)}`);
    if (c.fix) console.log(`        ${yellow("fix:")} ${c.fix}`);
  }
  const bad = out.filter((c) => c.status === "fail").length;
  const warn = out.filter((c) => c.status === "warn").length;
  console.log(`\n${out.length} checks - ${bad} failed - ${warn} worth a look`);
}

function installHooks() {
  const srcHooks = path.join(__dirname, "..", "hooks");
  if (!fs.existsSync(srcHooks)) { console.error("hooks/ not found next to this CLI — run from a repo checkout"); process.exit(1); }
  const hooksDir = path.join(base, "hooks");
  fs.mkdirSync(base, { recursive: true });
  fs.rmSync(hooksDir, { recursive: true, force: true });
  fs.cpSync(srcHooks, hooksDir, { recursive: true });
  // process.execPath is always valid TODAY, but it has symlinks resolved — on
  // Homebrew, nvm and fnm that lands on a version-pinned path like
  // /opt/homebrew/Cellar/node/25.2.1/bin/node. Written into a hook config, which
  // outlives the next `node` upgrade, it silently stops every hook from firing:
  // the interpreter it names simply isn't there any more, and a hook that never
  // runs looks exactly like an agent that isn't reporting.
  //
  // So prefer a stable path that resolves to the SAME binary — the same
  // interpreter, reached by a name that survives the upgrade. Same candidate list
  // the macOS installer's findNode() uses, so both installers agree. When none of
  // them is this node (a bare nvm/fnm setup with no stable alias), execPath stays:
  // no worse than before, and still correct today.
  const node = (() => {
    const real = (p) => { try { return fs.realpathSync(p); } catch { return null; } };
    const self = real(process.execPath);
    if (!self) return process.execPath;
    const stable = ["/usr/bin/node", "/usr/local/bin/node", "/opt/homebrew/bin/node",
                    path.join(os.homedir(), ".local/bin/node")];
    return stable.find((c) => c !== process.execPath && real(c) === self) || process.execPath;
  })();

  // Cursor and Antigravity run their hook via its shebang, and a GUI-launched app's
  // PATH is unreliable — `#!/usr/bin/env node` would silently never fire. Pin node.
  const pinNodeShebang = (file) => {
    if (!fs.existsSync(file)) return;
    const t = fs.readFileSync(file, "utf8");
    if (t.startsWith("#!")) fs.writeFileSync(file, "#!" + node + t.slice(t.indexOf("\n")));
    fs.chmodSync(file, 0o755);
  };
  const cursorJs = path.join(hooksDir, "cursor", "cursor.js");
  pinNodeShebang(cursorJs);

  const readConfig = (file) => {
    if (!fs.existsSync(file)) return {};
    const parsed = readJSON(file);
    if (!parsed || typeof parsed !== "object") {
      console.error(`skip: ${file} exists but is not parseable JSON — left untouched`);
      return null;
    }
    return parsed;
  };
  const sortedStringify = (v) => JSON.stringify(v, (k, val) =>
    val && typeof val === "object" && !Array.isArray(val)
      ? Object.keys(val).sort().reduce((o, kk) => ((o[kk] = val[kk]), o), {})
      : val, 2);
  const writeIfChanged = (file, root) => {
    const data = sortedStringify(root) + "\n";
    try { if (fs.readFileSync(file, "utf8") === data) return false; } catch {}
    fs.mkdirSync(path.dirname(file), { recursive: true });
    const t = file + "." + process.pid + ".tmp";
    fs.writeFileSync(t, data);
    fs.renameSync(t, file);
    return true;
  };
  const report = (name, changed) => console.log(`${changed ? "wired" : "ok   "}  ${name}`);

  // Claude Code — <configDir>/settings.json (default + CLAUDE_CONFIG_DIR + hint file)
  const claudeDirs = new Set([path.join(os.homedir(), ".claude")]);
  if (process.env.CLAUDE_CONFIG_DIR) claudeDirs.add(process.env.CLAUDE_CONFIG_DIR.replace(/^~/, os.homedir()));
  try {
    const raw = fs.readFileSync(path.join(base, "claude-config-dir"), "utf8").trim();
    if (raw) claudeDirs.add(raw.replace(/^~/, os.homedir()));
  } catch {}
  const dir = path.join(hooksDir, "claude");
  const claudeEvents = [
    ["SessionStart", `"${node}" "${dir}/lifecycle.js" start`, false, null],
    ["SessionEnd", `"${node}" "${dir}/lifecycle.js" end`, false, null],
    ["UserPromptSubmit", `"${node}" "${dir}/update.js" prompt`, false, null],
    ["PreToolUse", `"${node}" "${dir}/update.js" pre`, true, null],
    ["PostToolUse", `"${node}" "${dir}/update.js" post`, true, null],
    ["PermissionRequest", `"${node}" "${dir}/permission.js"`, true, 630],
    ["Stop", `"${node}" "${dir}/update.js" stop`, false, null],
  ];
  for (const cfgDir of claudeDirs) {
    const file = path.join(cfgDir, "settings.json");
    const root = readConfig(file);
    if (root === null) continue;
    const hooks = root.hooks && typeof root.hooks === "object" ? root.hooks : {};
    for (const [ev, rules] of Object.entries(hooks)) {
      if (!Array.isArray(rules)) continue;
      const kept = rules.filter((rule) => !((rule.hooks || []).some((h) => String(h.command || "").includes("/.agentbar/hooks/claude/"))));
      if (kept.length) hooks[ev] = kept; else delete hooks[ev];
    }
    for (const [ev, cmd, matcher, timeout] of claudeEvents) {
      const entry = { type: "command", command: cmd };
      if (timeout) entry.timeout = timeout;
      const rule = { hooks: [entry] };
      if (matcher) rule.matcher = "*";
      hooks[ev] = (hooks[ev] || []).concat([rule]);
    }
    root.hooks = hooks;
    report(`claude  ${file}`, writeIfChanged(file, root));
  }

  // Codex — ~/.codex/config.toml notify hook (append-only, never rewrite TOML)
  const codexDir = path.join(os.homedir(), ".codex");
  if (fs.existsSync(codexDir)) {
    const file = path.join(codexDir, "config.toml");
    let toml = ""; try { toml = fs.readFileSync(file, "utf8"); } catch {}
    const ours = `notify = ["${node}", "${path.join(hooksDir, "codex", "notify.js")}"]`;
    // tmp+rename like every other config write here — a crash mid-write must
    // not truncate the user's Codex config.
    const writeToml = (next) => {
      const t = file + "." + process.pid + ".tmp";
      fs.writeFileSync(t, next);
      fs.renameSync(t, file);
    };
    const line = toml.match(/^[ \t]*notify[ \t]*=[ \t]*\[[^\]]*\/\.agentbar\/hooks\/codex\/[^\]]*\]/m);
    if (line) {
      // Ours already — but "ours" is not "working". Every other config here is
      // rewritten whenever its content differs, so a moved node heals on the next
      // run. Codex used to stop at the marker, which made it the one integration
      // where a stale interpreter was permanent. Re-verify the interpreter.
      const interp = (line[0].match(/"([^"]*)"/) || [])[1];
      let alive = false;
      try { fs.accessSync(interp, fs.constants.X_OK); alive = true; } catch {}
      if (alive) report("codex   " + file, false);
      else { writeToml(toml.replace(line[0], ours)); report("codex   " + file, true); }
    }
    // Our marker somewhere the line regex could not read (hand-edited formatting,
    // a comment): leave it alone rather than appending a second notify key.
    else if (toml.includes("/.agentbar/hooks/codex/")) report("codex   " + file, false);
    else if (/^\s*notify\s*=/m.test(toml)) console.error(`skip: ${file} already has a notify hook — left untouched`);
    else {
      if (toml && !toml.endsWith("\n")) toml += "\n";
      writeToml(toml + ours + "\n");
      report("codex   " + file, true);
    }
  }

  // Cursor — ~/.cursor/hooks.json (command is a single executable path)
  const cursorDir = path.join(os.homedir(), ".cursor");
  if (fs.existsSync(cursorDir)) {
    const file = path.join(cursorDir, "hooks.json");
    const root = readConfig(file);
    if (root !== null) {
      root.version = root.version || 1;
      const hooks = root.hooks && typeof root.hooks === "object" ? root.hooks : {};
      for (const ev of ["sessionStart", "sessionEnd", "preToolUse", "postToolUse", "afterAgentResponse", "stop"]) {
        hooks[ev] = (Array.isArray(hooks[ev]) ? hooks[ev] : [])
          .filter((r) => !String(r.command || "").includes("/.agentbar/hooks/cursor/"))
          .concat([{ command: cursorJs }]);
      }
      root.hooks = hooks;
      report("cursor  " + file, writeIfChanged(file, root));
    }
  }

  // Antigravity — ~/.gemini/antigravity{,-cli}/hooks.json. Top level is named rule
  // groups; we own exactly one key ("agentbar") and never touch the rest. The script
  // runs via its shebang, and the stdin payload carries no event name, so the event
  // rides along as an argument. Observational only: PreToolUse writes no stdout.
  const antigravityJs = path.join(hooksDir, "antigravity", "antigravity.js");
  const antigravityDirs = ["antigravity", "antigravity-cli"]
    .map((d) => path.join(os.homedir(), ".gemini", d))
    .filter((d) => fs.existsSync(d));
  if (antigravityDirs.length) {
    pinNodeShebang(antigravityJs);
    const group = {};
    for (const ev of ["PreInvocation", "PreToolUse", "PostToolUse", "PostInvocation", "Stop"]) {
      const rule = { hooks: [{ type: "command", command: `"${antigravityJs}" ${ev}`, timeout: 5 }] };
      if (ev.endsWith("ToolUse")) rule.matcher = "*";
      group[ev] = [rule];
    }
    for (const agDir of antigravityDirs) {
      const file = path.join(agDir, "hooks.json");
      const root = readConfig(file);
      if (root === null) continue;
      root.agentbar = group;
      report("antigr  " + file, writeIfChanged(file, root));
    }
  }

  // Gemini — ~/.gemini/settings.json (timeout in ms)
  const geminiDir = path.join(os.homedir(), ".gemini");
  if (fs.existsSync(geminiDir)) {
    const file = path.join(geminiDir, "settings.json");
    const root = readConfig(file);
    if (root !== null) {
      const hooks = root.hooks && typeof root.hooks === "object" ? root.hooks : {};
      const cmd = `"${node}" "${path.join(hooksDir, "gemini", "gemini.js")}"`;
      const ours = (g) => (g.hooks || []).some((h) => String(h.command || "").includes("/.agentbar/hooks/gemini/"));
      for (const ev of ["SessionStart", "SessionEnd", "BeforeAgent", "BeforeTool", "AfterTool", "AfterAgent"]) {
        hooks[ev] = (Array.isArray(hooks[ev]) ? hooks[ev] : []).filter((g) => !ours(g))
          .concat([{ hooks: [{ type: "command", command: cmd, timeout: 5000 }] }]);
      }
      root.hooks = hooks;
      report("gemini  " + file, writeIfChanged(file, root));
    }
  }

  // Qwen Code — ~/.qwen/settings.json. Qwen speaks Claude-style hooks (same event
  // names, same stdin JSON), so the claude/ scripts serve it as-is with
  // AGENTBAR_AGENT naming the rows — the same reuse the macOS installer does.
  // Observational events only: Qwen's PermissionRequest decision contract is
  // unverified against permission.js, and a blocking hook must never be wired on
  // faith. Timeouts here are milliseconds (Qwen), not seconds (Claude).
  const qwenDir = path.join(os.homedir(), ".qwen");
  if (fs.existsSync(qwenDir)) {
    const file = path.join(qwenDir, "settings.json");
    const root = readConfig(file);
    if (root !== null) {
      const hooks = root.hooks && typeof root.hooks === "object" ? root.hooks : {};
      for (const [ev, rules] of Object.entries(hooks)) {
        if (!Array.isArray(rules)) continue;
        const kept = rules.filter((rule) => !((rule.hooks || []).some((h) => String(h.command || "").includes("/.agentbar/hooks/claude/"))));
        if (kept.length) hooks[ev] = kept; else delete hooks[ev];
      }
      const qwenEvents = [
        ["SessionStart", `"${node}" "${dir}/lifecycle.js" start`, false],
        ["SessionEnd", `"${node}" "${dir}/lifecycle.js" end`, false],
        ["UserPromptSubmit", `"${node}" "${dir}/update.js" prompt`, false],
        ["PreToolUse", `"${node}" "${dir}/update.js" pre`, true],
        ["PostToolUse", `"${node}" "${dir}/update.js" post`, true],
        // Qwen splits the failure paths into their own events; without them a
        // turn that errors out keeps animating as if it were still working.
        ["PostToolUseFailure", `"${node}" "${dir}/update.js" post`, true],
        ["Stop", `"${node}" "${dir}/update.js" stop`, false],
        ["StopFailure", `"${node}" "${dir}/update.js" fail`, false],
      ];
      for (const [ev, cmd, matcher] of qwenEvents) {
        const rule = { hooks: [{ type: "command", command: cmd, timeout: 5000, env: { AGENTBAR_AGENT: "qwen" } }] };
        if (matcher) rule.matcher = "*";
        hooks[ev] = (hooks[ev] || []).concat([rule]);
      }
      root.hooks = hooks;
      report(`qwen    ${file}`, writeIfChanged(file, root));
    }
  }

  // GitHub Copilot CLI — ~/.copilot/hooks/agentbar.json (or $COPILOT_HOME/hooks).
  // The PascalCase event names deliver the VS Code/Claude payload shape, so the
  // claude/ scripts serve Copilot unchanged, same reuse as Qwen above.
  // `exec` + `args` runs node directly: a bash wrapper would make the hook's parent
  // a shell that exits at once, and ppid is the liveness handle rows are pruned by.
  // permissionRequest blocks and decides, which is what remote Allow/Deny needs; it
  // stayed unwired until its payload had been logged off a real session rather than
  // taken on faith (Scripts/hooks/copilot/README.md). Not preToolUse: those are
  // fail-CLOSED on a crash, so one unhandled exception would silently deny a tool call.
  // AgentBar owns this whole file; Copilot loads every *.json in the dir, so the
  // user's own hooks live in theirs and are never touched.
  const copilotDir = process.env.COPILOT_HOME || path.join(os.homedir(), ".copilot");
  if (fs.existsSync(copilotDir)) {
    const file = path.join(copilotDir, "hooks", "agentbar.json");
    const copilotEvents = [
      ["SessionStart", "lifecycle.js", "start"],
      ["SessionEnd", "lifecycle.js", "end"],
      ["UserPromptSubmit", "update.js", "prompt"],
      ["PreToolUse", "update.js", "pre"],
      ["PostToolUse", "update.js", "post"],
      // A failed tool call is still mid-turn: keep the session working.
      ["PostToolUseFailure", "update.js", "post"],
      ["Stop", "update.js", "stop"],
      // Only Copilot reports errors as their own event; update.js reads the
      // payload's `recoverable` so a retry doesn't end the turn early.
      ["ErrorOccurred", "update.js", "fail"],
    ];
    const hooks = {};
    for (const [ev, script, arg] of copilotEvents) {
      hooks[ev] = [{ type: "command", exec: node, args: [`${dir}/${script}`, arg],
                     timeoutSec: 5, env: { AGENTBAR_AGENT: "copilot" } }];
    }
    // The blocking one. Its timeout sits ABOVE the hook's own wait (600s) so the
    // hook gives up first and exits silently into the terminal prompt — the other
    // way round, Copilot would kill it mid-wait. Claude's entry uses 630 likewise.
    hooks.permissionRequest = [{ type: "command", exec: node,
                                 args: [`${dir}/permission.js`],
                                 timeoutSec: 630, env: { AGENTBAR_AGENT: "copilot" } }];
    fs.mkdirSync(path.dirname(file), { recursive: true });
    report(`copilot ${file}`, writeIfChanged(file, { version: 1, hooks }));
  }

  // OpenCode — ~/.config/opencode/plugins/agentbar.js. OpenCode loads JS plugins
  // from its config dir; ours observes the event bus and mirrors it into state
  // files. Copied on change, same refresh-with-the-installer rule as macOS.
  const opencodeDir = path.join(os.homedir(), ".config", "opencode");
  if (fs.existsSync(opencodeDir)) {
    const file = path.join(opencodeDir, "plugins", "agentbar.js");
    const src = fs.readFileSync(path.join(hooksDir, "opencode", "agentbar.js"), "utf8");
    let changed = true;
    try { changed = fs.readFileSync(file, "utf8") !== src; } catch {}
    if (changed) {
      fs.mkdirSync(path.dirname(file), { recursive: true });
      const t = file + "." + process.pid + ".tmp";
      fs.writeFileSync(t, src);
      fs.renameSync(t, file);
    }
    report("opencode " + file, changed);
  }
  console.log("Done. Start a NEW agent session to see it (hooks snapshot at session start).");
}

// MARK: - Main

const [cmd, ...argv] = process.argv.slice(2);
const json = argv.includes("--json");
switch (cmd) {
  case "status": case undefined: printStatus(json); break;
  case "requests": printRequests(json); break;
  case "approve": case "allow": decide("allow", argv); break;
  case "deny": decide("deny", argv); break;
  case "answer": answerCmd(argv.filter((a) => a !== "--json")); break;
  case "watch": watch(argv); break;
  case "waybar": waybar(); break;
  case "history": printHistory(argv, json); break;
  case "doctor": doctor(json); break;
  case "install-hooks": installHooks(); break;
  case "--help": case "help": default:
    console.log(`agentbar — AI coding agents' status & remote approval (file protocol: ~/.agentbar)

  agentbar [status] [--json]      live sessions
  agentbar requests [--json]      pending approvals with detail
  agentbar approve [n] [--always] answer newest (or n-th) permission
  agentbar deny [n]
  agentbar answer [n] <label|num>... answer a pending question by option
  agentbar watch [-i SEC]         live view + keys (a allow/A always/d deny/f defer/1-9 answer/q quit);
                                  enables remote approval
  agentbar waybar                 JSON for waybar/polybar (poll <= 30s)
  agentbar history [--days N]     what finished today (or over N days) [--json]
  agentbar doctor [--json]        why an agent isn't showing up: hooks, node path, permissions
  agentbar install-hooks          wire Claude/Codex/Cursor/Antigravity/Gemini/Qwen/Copilot/OpenCode hooks (Linux installer)`);
    break;
}
